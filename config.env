# Chihuahua Telegram — build settings. Edit, commit, and a new build starts.
APP_NAME=Chihuahua 1
APP_PACKAGE=com.chihuahua.messenger
MAX_ACCOUNTS=32
# Whether the app notifies at all. Only Chihuahua 1 does; every other app sets its own
# APP<n>_NOTIFICATIONS=false and never shows a notification, plays a sound or counts a badge.
NOTIFICATIONS=true
# The second app, built from the same code in the same run. Android installs it alongside the
# first because the application id differs; it has its own logins and 32 accounts.
APP2_NAME=Chihuahua 2
APP2_PACKAGE=com.chihuahua.messenger2
APP2_ICONS=icons2
APP2_NOTIFICATIONS=false
# The third app. Same code again, plus two things only it does: it offers to set up Two-Step
# Verification after a login, and it joins the groups/channels below (muted) on every new login.
APP3_NAME=Chihuahua 3
APP3_PACKAGE=com.chihuahua.messenger3
APP3_ICONS=icons3
APP3_NOTIFICATIONS=false
APP3_PROMPT_2FA=true
APP3_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg
# The fourth app: Chihuahua 3 all over again (2FA prompt, same auto-join list) with its own icon.
APP4_NAME=Chihuahua 4
APP4_PACKAGE=com.chihuahua.messenger4
APP4_ICONS=icons4
APP4_NOTIFICATIONS=false
APP4_PROMPT_2FA=true
APP4_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg
# The fifth app: the same again (2FA prompt, same auto-join list), its own icon.
APP5_NAME=Chihuahua 5
APP5_PACKAGE=com.chihuahua.messenger5
APP5_ICONS=icons5
APP5_NOTIFICATIONS=false
APP5_PROMPT_2FA=true
APP5_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg
# The sixth app: the same as 3, 4 and 5 (2FA offer, the same auto-join list). Borrows the cat
# icon until it gets a photo of its own.
APP6_NAME=Chihuahua 6
APP6_PACKAGE=com.chihuahua.messenger6
APP6_ICONS=icons3
APP6_NOTIFICATIONS=false
APP6_PROMPT_2FA=true
APP6_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg
# Chihuahua 9: Chihuahua 3 without the Two-Step Verification offer; after a login it offers to
# create a channel instead, and it auto-joins its own list. Icon: both dogs, cheek to cheek.
APP9_NAME=Chihuahua 9
APP9_PACKAGE=com.chihuahua.messenger9
APP9_ICONS=icons9
APP9_NOTIFICATIONS=false
APP9_PROMPT_2FA=false
APP9_PROMPT_CHANNEL=true
APP9_AUTO_JOIN=massageinsg,sgtelegram1,sgmassage4u,sgrelaxj,sgprettymassage,mensdirectory,sg_jb_massage,sgbestservices
# A group promoted by a row at the top of the Setup tab (tap opens it; you join there).
# Clear PROMO_GROUP to drop the row. Username without the @.
PROMO_GROUP=massageinsg
PROMO_TITLE=🇸🇬 @MassageInSG
# arm64-v8a covers every phone from the last ~8 years. "all" also builds 32-bit ARM and x86 (4x slower).
BUILD_ABI=arm64-v8a
# Telegram for Android source commit to build (DrKLO/Telegram on GitHub). 62b56a0 = version 12.10.1.
TELEGRAM_COMMIT=62b56a07ca7e30e39f7fd00a6728d6bbd716ca1c
KEYSTORE_ALIAS=chihuahua
GRADLE_HEAP=8g
