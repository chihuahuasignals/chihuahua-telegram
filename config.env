# Chihuahua Telegram — build settings. Edit, commit, and a new build starts.
APP_NAME=Chihuahua Telegram
APP_PACKAGE=com.chihuahua.messenger
MAX_ACCOUNTS=32
# arm64-v8a covers every phone from the last ~8 years. "all" also builds 32-bit ARM and x86 (4x slower).
BUILD_ABI=arm64-v8a
# Telegram for Android source commit to build (DrKLO/Telegram on GitHub). 62b56a0 = version 12.10.1.
TELEGRAM_COMMIT=62b56a07ca7e30e39f7fd00a6728d6bbd716ca1c
KEYSTORE_ALIAS=chihuahua
GRADLE_HEAP=8g
