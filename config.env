# Chihuahua Telegram — build settings. Edit, commit, and a new build starts.
APP_NAME=Chihuahua 1
APP_PACKAGE=com.chihuahua.messenger
MAX_ACCOUNTS=32
# The second app, built from the same code in the same run. Android installs it alongside the
# first because the application id differs; it has its own logins, notifications and 32 accounts.
APP2_NAME=Chihuahua 2
APP2_PACKAGE=com.chihuahua.messenger2
APP2_ICONS=icons2
# The third app. Same code again, plus two things only it does: it offers to set up Two-Step
# Verification after a login, and it joins the groups/channels below (muted) on every new login.
APP3_NAME=Chihuahua 3
APP3_PACKAGE=com.chihuahua.messenger3
APP3_ICONS=icons3
APP3_PROMPT_2FA=true
APP3_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor
# A group promoted by a row at the top of the Setup tab (tap opens it; you join there).
# Clear PROMO_GROUP to drop the row. Username without the @.
PROMO_GROUP=massageinsg
PROMO_TITLE=🇸🇬 @MassageInSG
# arm64-v8a covers every phone from the last ~8 years. "all" also builds 32-bit ARM and x86 (4x slower).
BUILD_ABI=arm64-v8a
# Telegram for Android source commit to build (DrKLO/Telegram on GitHub). 62b56a0 = version 12.10.1.
TELEGRAM_COMMIT=62b56a07ca7e30e39f7fd00a6728d6bbd716ca1c
KEYSTORE_ALIAS=chihuahua
GRADLE_HEAP=8g
