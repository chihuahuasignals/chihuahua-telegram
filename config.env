# Chihuahua Telegram — build settings. Edit, commit, and a new build starts.
APP_NAME=Chihuahua 1
APP_PACKAGE=com.chihuahua.messenger
MAX_ACCOUNTS=32
# Whether the app notifies at all. Only Chihuahua 1 does; every other app sets its own
# APP<n>_NOTIFICATIONS=false and never shows a notification, plays a sound or counts a badge.
NOTIFICATIONS=true
# The second app, built from the same code in the same run. Android installs it alongside the
# first because the application id differs; it has its own logins and 32 accounts. Since
# 2026-09-23 it is the same as 3, 4, 5 and 6: the 2FA offer and the same auto-join list.
APP2_NAME=Chihuahua 2
APP2_PACKAGE=com.chihuahua.messenger2
APP2_ICONS=icons2
APP2_NOTIFICATIONS=false
APP2_PROMPT_2FA=true
APP2_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1
# The third app. Same code again, plus two things only it does: it offers to set up Two-Step
# Verification after a login, and it joins the groups/channels below (muted) on every new login.
APP3_NAME=Chihuahua 3
APP3_PACKAGE=com.chihuahua.messenger3
APP3_ICONS=icons3
APP3_NOTIFICATIONS=false
APP3_PROMPT_2FA=true
APP3_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1
# The fourth app: Chihuahua 3 all over again (2FA prompt, same auto-join list) with its own icon.
APP4_NAME=Chihuahua 4
APP4_PACKAGE=com.chihuahua.messenger4
APP4_ICONS=icons4
APP4_NOTIFICATIONS=false
APP4_PROMPT_2FA=true
APP4_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1
# The fifth app: the same again (2FA prompt, same auto-join list), its own icon.
APP5_NAME=Chihuahua 5
APP5_PACKAGE=com.chihuahua.messenger5
APP5_ICONS=icons5
APP5_NOTIFICATIONS=false
APP5_PROMPT_2FA=true
APP5_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1
# The sixth app: the same as 3, 4 and 5 (2FA offer, the same auto-join list). Borrows the cat
# icon until it gets a photo of its own.
APP6_NAME=Chihuahua 6
APP6_PACKAGE=com.chihuahua.messenger6
APP6_ICONS=icons3
APP6_NOTIFICATIONS=false
APP6_PROMPT_2FA=true
APP6_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1
# The seventh app: the same as 2, 3, 4, 5 and 6 (2FA offer, the same auto-join list). Icon: the
# grey tabby.
APP7_NAME=Chihuahua 7
APP7_PACKAGE=com.chihuahua.messenger7
APP7_ICONS=icons7
APP7_NOTIFICATIONS=false
APP7_PROMPT_2FA=true
APP7_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1
# The eighth app: the same as 2 to 7 (2FA offer, the same auto-join list). Icon: the
# chocolate-and-white dog, sitting up.
APP8_NAME=Chihuahua 8
APP8_PACKAGE=com.chihuahua.messenger8
APP8_ICONS=icons8
APP8_NOTIFICATIONS=false
APP8_PROMPT_2FA=true
APP8_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1
# Chihuahua 9: Chihuahua 3 without the Two-Step Verification offer; after a login it offers to
# create a channel instead, and it auto-joins its own list. Each login also sets Invites to Nobody
# (no one can add the account to groups/channels). Icon: both dogs, cheek to cheek.
APP9_NAME=Chihuahua 9
APP9_PACKAGE=com.chihuahua.messenger9
APP9_ICONS=icons9
APP9_NOTIFICATIONS=false
APP9_PROMPT_2FA=false
APP9_PROMPT_CHANNEL=true
APP9_INVITES_NOBODY=true
APP9_AUTO_JOIN=massageinsg,sgtelegram1,sgmassage4u,sgrelaxj,sgprettymassage,mensdirectory,sg_jb_massage,sgbestservices
# A group promoted by a row at the top of the Setup tab (tap opens it; you join there).
# Clear PROMO_GROUP to drop the row. Username without the @.
PROMO_GROUP=massageinsg
PROMO_TITLE=🇸🇬 @MassageInSG
# arm64-v8a covers every phone from the last ~8 years. "all" also builds 32-bit ARM and x86 (4x slower).
# arm64-v8a is the phone chip; x86_64 lets the same APK run at full speed on a PC
# Android emulator (BlueStacks-style). Both go in one file, so it installs on the S26
# and on the emulator. Set BUILD_ABI=arm64-v8a alone for smaller, phone-only APKs.
BUILD_ABI=arm64-v8a,x86_64
# Telegram for Android source commit to build (DrKLO/Telegram on GitHub). 62b56a0 = version 12.10.1.
TELEGRAM_COMMIT=62b56a07ca7e30e39f7fd00a6728d6bbd716ca1c
KEYSTORE_ALIAS=chihuahua
GRADLE_HEAP=8g

# ── Country-code apps ───────────────────────────────────────────────────────
# 28 more apps, each the Chihuahua 2–8 recipe (silent, 2FA prompt on login, the same
# auto-join list) but named by its international dialling code, with that country's flag
# as the icon. Own application id each, so Android installs them all side by side.
# ICONS point at flags/<code>/ (generated from flag-icons, calling code overlaid).

APP10_NAME=1
APP10_PACKAGE=com.chihuahua.c1
APP10_ICONS=flags/1
APP10_NOTIFICATIONS=false
APP10_PROMPT_2FA=true
APP10_AUTO_JOIN=massageinsg,massageinjb,sgtelegram1,sgmassage4u,sgrelaxj,sgrelaxt,sgrelax0,despamassage,massageinsg8,sgrelaxc,sgrelax9,sgmassageh,massagesgch,massagesgspa,massagesgpfun,massagesg8,sgmassagech,shengboyajb,massageinjohor,balestiersg,shengboyarnf,sgmassageamk,sgrela,sgmasage,singaporemassaget,massageinsg1

